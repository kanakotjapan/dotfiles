{
  "show_edit_predictions": false,
  "assistant": {
    "version": "2",
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "cursor_blink": false,
  "current_line_highlight": "none",
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "experimental.theme_overrides": {
    "element.active": "#0b0b0b"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "git": {
    "git_gutter": "hide"
  },
  "git_panel": {
    "button": false
  },
  "gutter": {
    "code_actions": false
  },
  // "max_tabs": 1,
  "notification_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "project_panel": {
    "button": false,
    "git_status": false
  },
  "scrollbar": {
    "git_diff": false
  },
  "tab_bar": {
    "show": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "button": false
  },
  "theme": "GitHub Dark Default",
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  }
}
